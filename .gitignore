# RStudio and R session files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Laboratory data from the Catteruccia group: unpublished, never commit.
# Raw workbooks and everything derived from them (cleaned summaries) live here.
data_private/

# Fit outputs, tables and figures: results stay off GitHub until chosen.
outputs/

# hipercow's cluster folder: per-machine config, the cluster's package library,
# task files and logs. Lives only on the network share.
hipercow/

# Data and result file types are ignored everywhere by default. To publish a
# specific file, un-ignore it by path below, e.g.  !inst/extdata/lookup.csv
*.rds
*.RDS
*.rda
*.RData
*.csv
*.xlsx
*.xls
*.docx
*.msg
*.pdf
*.png

# Compiled Stan models and other build artefacts
*.exe
*.o
*.so
*.dll

# The draws table for the projections (analysis/06_make_draws.R): public.
!inst/extdata/projection_draws.csv

# The calibrated baseline EIRs (analysis/07a, collected by 07b): nine model outputs, one per
# region, with the versions they depend on. Tracked because the cluster runs a frozen copy of
# the code at a commit, so it can only read what has been committed.
!inst/extdata/calibrated_eir.csv
